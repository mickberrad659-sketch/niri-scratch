// Add these workspaces at top level in ~/.config/niri/config.kdl.
workspace "scratch:web"
workspace "scratch:d"
workspace "scratch:f"
workspace "scratch:chat"
workspace "scratch:u"

// Add these entries inside a binds { ... } block.
Mod+S repeat=false { spawn "niri-scratch" "toggle" "web"; }
Mod+D repeat=false { spawn "niri-scratch" "toggle" "d"; }
Mod+F repeat=false { spawn "niri-scratch" "toggle" "f"; }
Mod+Slash repeat=false { spawn "niri-scratch" "toggle" "chat"; }
Mod+U repeat=false { spawn "niri-scratch" "toggle" "u"; }
